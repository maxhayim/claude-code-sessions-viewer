#!/usr/bin/env bash
# claude-sessions — visual, fuzzy-searchable browser for every Claude Code
# session on this machine, with a live preview pane. Selecting one resumes it.
#
# Requires fzf: brew install fzf
#
# Run this directly in your terminal (NOT as a /slash-command inside Claude
# Code) — resuming a session has to replace the running process, which a
# plugin command can't do from inside an active session.

set -euo pipefail

# Resolve symlinks (e.g. `ln -s .../bin/claude-sessions /usr/local/bin/...`,
# or a Homebrew-installed symlink) so PLUGIN_SCRIPTS below points at the
# real script directory rather than wherever the symlink lives.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PLUGIN_SCRIPTS="$SCRIPT_DIR/../plugins/sessions-viewer/scripts"

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required but not installed. Attempting to install it now..." >&2
  if command -v brew >/dev/null 2>&1; then
    brew install fzf >&2
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get install -y fzf >&2
  else
    echo "Could not find a supported package manager (brew or apt-get)." >&2
    echo "Install fzf manually: https://github.com/junegunn/fzf#installation" >&2
    exit 1
  fi
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf installation did not complete successfully. Please install it manually and try again." >&2
  exit 1
fi

# Claude's brand accent color (#d97757), as a 24-bit ANSI escape. Skipped
# for non-interactive terminals or when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  ACCENT=$'\033[38;2;217;119;87m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  ACCENT=""
  BOLD=""
  RESET=""
fi

cat <<EOF
${ACCENT}   ╭──────────────────────────────────────╮
   │                                        │
   │   ┌─┐┌─┐┌─┐┬  ┬                        │
   │   │  ├─┘└─┐└┐┌┘                        │
   │   └─┘┴  └─┘ └┘   sessions viewer       │
   │                                        │
   │   for Claude Code                      │
   │                                        │
   ╰──────────────────────────────────────╯${RESET}

   ${BOLD}${ACCENT}Claude Code Sessions${RESET}

EOF

# Shared look for both stages below: a centered, roughly square box in the
# middle of the terminal rather than a full-screen list.
FZF_BOX=(
  --height=65% --margin=8%,22% --padding=1
  --layout=reverse --info=inline
  --border=rounded --border-label-pos=3
  --prompt="Search ❯ " --pointer="▶" --marker="✓"
  --bind="double-click:accept"
  --color="pointer:#d97757,prompt:#d97757,marker:#d97757,border:#d97757,label:#d97757,header:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold"
)

# --- Pick a project. Enter/double-click jumps straight into its latest
# session; ctrl-o instead opens the full session list for that project so
# you can pick an older one. ---------------------------------------------
RESULT=$(python3 "$PLUGIN_SCRIPTS/list_sessions.py" --projects-tsv | \
  fzf --delimiter='\t' \
      --preview="python3 '$PLUGIN_SCRIPTS/list_sessions.py' --project-preview='{1}'" \
      --preview-window=down:50%:wrap,border-rounded \
      --header="enter/double-click: resume latest  ·  ctrl-o: pick a different session  ·  esc: cancel" \
      --border-label=" Project Names: " \
      --expect=ctrl-o \
      "${FZF_BOX[@]}")

KEY=$(printf '%s\n' "$RESULT" | head -n1)
PROJECT_SELECTED=$(printf '%s\n' "$RESULT" | tail -n +2)

if [ -z "$PROJECT_SELECTED" ]; then
  echo "No project selected."
  exit 0
fi

PROJECT_NAME=$(printf '%s' "$PROJECT_SELECTED" | cut -f1)

if [ "$KEY" = "ctrl-o" ]; then
  # --- Secondary menu: every session in this project, most recent first ---
  SELECTED=$(python3 "$PLUGIN_SCRIPTS/list_sessions.py" --tsv --sort-by=date --project="$PROJECT_NAME" | \
    fzf --delimiter='\t' \
        --with-nth=1,5 \
        --preview="python3 '$PLUGIN_SCRIPTS/preview_session.py' {6}" \
        --preview-window=right:60%:wrap,border-rounded \
        --header="enter/double-click: resume  ·  esc: cancel" \
        --border-label=" Sessions: $PROJECT_NAME " \
        "${FZF_BOX[@]}")
else
  # --- Default: the single latest session for this project ---
  SELECTED=$(python3 "$PLUGIN_SCRIPTS/list_sessions.py" --tsv --sort-by=date --project="$PROJECT_NAME" | head -n1)
fi

if [ -z "$SELECTED" ]; then
  echo "No session selected."
  exit 0
fi

SESSION_ID=$(printf '%s' "$SELECTED" | cut -f4)
SESSION_PROJECT_PATH=$(printf '%s' "$SELECTED" | cut -f3)

if [ ! -d "$SESSION_PROJECT_PATH" ]; then
  echo "Project directory no longer exists: $SESSION_PROJECT_PATH" >&2
  exit 1
fi

cd "$SESSION_PROJECT_PATH"
exec claude --resume "$SESSION_ID"
