#!/usr/bin/env bash
# claude-sessions — visual, fuzzy-searchable browser for every Claude Code
# session on this machine, with a live preview pane. Selecting one resumes it.
#
# Requires fzf: brew install fzf
#
# Run this directly in your terminal (NOT as a /slash-command inside Claude
# Code) — resuming a session has to replace the running process, which a
# plugin command can't do from inside an active session.

set -euo pipefail

# Resolve symlinks (e.g. `ln -s .../bin/claude-sessions /usr/local/bin/...`,
# or a Homebrew-installed symlink) so PLUGIN_SCRIPTS below points at the
# real script directory rather than wherever the symlink lives.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PLUGIN_SCRIPTS="$SCRIPT_DIR/../plugins/sessions-viewer/scripts"

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required but not installed. Attempting to install it now..." >&2
  if command -v brew >/dev/null 2>&1; then
    brew install fzf >&2
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get install -y fzf >&2
  else
    echo "Could not find a supported package manager (brew or apt-get)." >&2
    echo "Install fzf manually: https://github.com/junegunn/fzf#installation" >&2
    exit 1
  fi
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf installation did not complete successfully. Please install it manually and try again." >&2
  exit 1
fi

# Claude's brand accent color (#d97757), as a 24-bit ANSI escape. Skipped
# for non-interactive terminals or when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  ACCENT=$'\033[38;2;217;119;87m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  ACCENT=""
  BOLD=""
  RESET=""
fi

# The logo used to be plain text printed before fzf launches — but that's
# just static terminal output, and a tall fzf box growing beneath it could
# scroll it out of view (or off-screen entirely on a short terminal), with
# no way to get it back short of restarting. Building it as fzf's own
# --header instead makes it part of fzf's live-managed box: fzf redraws
# its header on every frame, so it can never scroll away or be lost for
# as long as the picker is open.
LOGO="╭──────────────────────────────────────────╮
│                                          │
│   ┌─┐┌─┐┌─┐┬  ┬                          │
│   │  │  └─┐└┐┌┘                          │
│   └─┘└─┘└─┘ └┘   Claude Code             │
│                       Sessions Viewer    │
│                                          │
╰──────────────────────────────────────────╯
"

# Shared look: a large, mostly-full-terminal box (not a small centered
# tile) so long project/session names don't get clipped, with Search as
# its own separate bordered box above the results list. (Note: this split
# is purely visual — in fzf, typing always filters the list immediately
# from anywhere, with no "focus" to navigate into; you never need to press
# Up to reach the search box before typing works.) Left headroom (85% vs.
# a near-full 92%) so there's room for the header (logo) above the list.
# shellcheck disable=SC2054  # commas below are fzf --color value syntax, not array-element separators
FZF_BOX=(
  --height=85% --margin=2%,4% --padding=1
  --layout=reverse --info=inline
  --input-border=rounded --input-label=" 🔍 Search " --input-label-pos=3
  --list-border=rounded --list-label-pos=3
  --prompt="❯ " --ghost="Type to search — no need to press anything first" --pointer="▶" --marker="✓"
  --multi
  --bind="double-click:accept"
  --footer-border=rounded
  --color="pointer:#d97757,prompt:#d97757,marker:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold,input-border:#d97757,input-label:#d97757:bold,list-border:#d97757,list-label:#d97757:bold,header:#d97757,footer:#d97757,footer-border:#d97757,border:#d97757,preview-border:#d97757,info:#d97757,separator:#d97757,scrollbar:#d97757,preview-scrollbar:#d97757,spinner:#d97757"
)

# A pinned row at the very top for starting a fresh session, ahead of the
# alphabetical list. Uses the same 7-tab-field shape as real rows so the
# same cut -fN extraction works; session_id is a sentinel no real UUID can
# match. Quoted with %q so it can be safely re-embedded, byte-for-byte, in
# the reload command below (which needs to reconstruct it after a delete).
NEW_SESSION_ROW=$(printf '\t\t\t__NEW_SESSION__\t\t\t%s+ Start New Session%s' "${BOLD}${ACCENT}" "$RESET")
NEW_SESSION_ROW_Q=$(printf '%q' "$NEW_SESSION_ROW")

# Two sort modes: alphabetical (default, dictionary-style letter dividers)
# and most-recent-first (no dividers — they only make sense when rows are
# actually grouped by starting letter, which date-sort isn't).
LIST_CMD="{ printf '%s\\n' $NEW_SESSION_ROW_Q; python3 '$PLUGIN_SCRIPTS/list_sessions.py' --tsv --sort-by=session --grouped; }"
LIST_CMD_DATE="{ printf '%s\\n' $NEW_SESSION_ROW_Q; python3 '$PLUGIN_SCRIPTS/list_sessions.py' --tsv --sort-by=date; }"

# --- All sessions, every project, one list: every session shown by its
# name (or first-message preview if never renamed), alphabetically, grouped
# into dictionary-style letter sections (A, B, C, ...). Moving the selection
# updates the preview pane with when it was last active, where it lives, its
# context-window usage, and the conversation itself. Enter/double-click
# opens it; right arrow opens an Open/Rename/Delete action menu for the
# highlighted row; Tab marks rows for ctrl-x bulk-delete; ctrl-r/ctrl-n
# switch sort mode. Reloads the list afterward wherever a delete could have
# happened. -------------------------------------------------------------
SELECTED=$(eval "$LIST_CMD" | \
  fzf --ansi \
      --delimiter='\t' \
      --with-nth=7 \
      --preview="python3 '$PLUGIN_SCRIPTS/preview_session.py' '{6}' '{1}' '{3}'" \
      --preview-window=right:55%:wrap,border-rounded \
      --header="${ACCENT}${LOGO}${RESET}" \
      --header-first \
      --footer="type to search · tab: mark · ctrl-x: delete marked · ctrl-r: recent · ctrl-n: a-z · right arrow: open/rename/delete · esc: cancel" \
      --list-label=" All Sessions " \
      --bind="right:execute(bash '$PLUGIN_SCRIPTS/session_action.sh' '{4}' '{6}' '{3}' '{7}')+reload($LIST_CMD)" \
      --bind="ctrl-x:execute(bash '$PLUGIN_SCRIPTS/bulk_delete.sh' {+4} -- {+6})+reload($LIST_CMD)" \
      --bind="ctrl-r:reload($LIST_CMD_DATE)" \
      --bind="ctrl-n:reload($LIST_CMD)" \
      "${FZF_BOX[@]}")

if [ -z "$SELECTED" ]; then
  echo "No session selected."
  exit 0
fi

# --multi means Enter on several Tab-marked rows returns all of them at
# once, which would silently corrupt every single-session cut -fN below.
# Refuse to guess which one to open — bulk actions belong to ctrl-x.
if [ "$(printf '%s\n' "$SELECTED" | wc -l)" -gt 1 ]; then
  echo "Multiple sessions marked — press ctrl-x to bulk-delete them, or unmark (Tab) all but one and press Enter to open it." >&2
  exit 1
fi

SESSION_ID=$(printf '%s' "$SELECTED" | cut -f4)

# Letter-divider rows are unselectable in spirit — if one somehow gets
# accepted (e.g. a stray Enter), treat it the same as no selection.
case "$(printf '%s' "$SELECTED" | cut -f7)" in
  *§*) echo "No session selected."; exit 0 ;;
esac

if [ "$SESSION_ID" = "__NEW_SESSION__" ]; then
  printf '%sSession name: %s' "${ACCENT}" "${RESET}"
  read -r NEW_NAME
  if [ -n "$NEW_NAME" ]; then
    exec claude "/rename $NEW_NAME"
  else
    exec claude
  fi
fi

SESSION_PROJECT_PATH=$(printf '%s' "$SELECTED" | cut -f3)
SESSION_JSONL_PATH=$(printf '%s' "$SELECTED" | cut -f6)

# The list is a fresh scan each run, but a session can still vanish between
# that scan and this exec — most commonly because it was just removed via
# the right-arrow Delete action. Check for that explicitly and say so,
# rather than letting `claude`'s raw "No conversation found" error surface
# with no context.
if [ ! -f "$SESSION_JSONL_PATH" ]; then
  echo "This session no longer exists (it may have been deleted)." >&2
  exit 1
fi

if [ ! -d "$SESSION_PROJECT_PATH" ]; then
  echo "Project directory no longer exists: $SESSION_PROJECT_PATH" >&2
  exit 1
fi

cd "$SESSION_PROJECT_PATH"
exec claude --resume "$SESSION_ID"
