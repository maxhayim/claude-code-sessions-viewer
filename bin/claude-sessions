#!/usr/bin/env bash
# claude-sessions — visual, fuzzy-searchable browser for every Claude Code
# session on this machine, plus other sessions already running (local or
# backgrounded) and Anthropic-hosted cloud sessions. Selecting a local
# session shows an Open/Rename/Delete/Back menu with that session's info;
# Open resumes it.
#
# Requires fzf: brew install fzf
#
# Run this directly in your terminal (NOT as a /slash-command inside Claude
# Code) — resuming a session has to replace the running process, which a
# plugin command can't do from inside an active session.

set -euo pipefail

# Resolve symlinks (e.g. `ln -s .../bin/claude-sessions /usr/local/bin/...`,
# or a Homebrew-installed symlink) so PLUGIN_SCRIPTS below points at the
# real script directory rather than wherever the symlink lives.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PLUGIN_SCRIPTS="$SCRIPT_DIR/../plugins/sessions-viewer/scripts"

# shellcheck source-path=SCRIPTDIR
# shellcheck source=SCRIPTDIR/../plugins/sessions-viewer/scripts/cloud_sessions.sh
source "$PLUGIN_SCRIPTS/cloud_sessions.sh"

# --- Compact-mode detection (for small/narrow terminals, e.g. an SSH
# session from an M5Stack Cardputer Zero or similar thin client) --------
COMPACT_COLS_THRESHOLD=90
COMPACT_LINES_THRESHOLD=25
COMPACT=""

for arg in "$@"; do
  case "$arg" in
    --compact) COMPACT=1 ;;
    --no-compact) COMPACT=0 ;;
    -h|--help)
      cat <<'EOF'
Usage: claude-sessions [--compact|--no-compact]

  --compact      Force the compact, narrow-terminal layout
  --no-compact   Force the normal, full-size layout
  -h, --help     Show this help and exit

With no flag, the layout is auto-detected from the terminal size. Set
CLAUDE_SESSIONS_VIEWER_COMPACT=1 (or =0) in your environment to override
auto-detection without passing a flag every time (e.g. in your SSH
client's startup command on a small device).
EOF
      exit 0
      ;;
  esac
done

# `tput cols`/`tput lines` query window size via an ioctl on their OWN
# stdout — inside a `$(...)` command substitution that's a pipe, not the
# tty, so the query silently fails and tput falls back to a terminfo
# default (often 80x24) instead of the real size. `stty size </dev/tty`
# sidesteps this: it queries via its *stdin*, so redirecting that from
# /dev/tty gets the real controlling-terminal size regardless of what
# stty's own stdout is connected to.
terminal_size() {
  TERM_COLS=""
  TERM_LINES=""
  if [ -n "${COLUMNS:-}" ] && [ -n "${LINES:-}" ]; then
    TERM_COLS="$COLUMNS"
    TERM_LINES="$LINES"
  else
    local size
    # The `exec 2>/dev/null` runs first, inside this same subshell, so it
    # also catches the shell's own "/dev/tty: no such device" message
    # when there's no controlling terminal at all (e.g. CI) — that
    # failure happens while bash sets up the `<` redirect, before stty
    # itself runs, so a plain trailing `stty ... 2>/dev/null` wouldn't
    # catch it.
    if size=$(exec 2>/dev/null; stty size </dev/tty); then
      TERM_LINES="${size%% *}"
      TERM_COLS="${size##* }"
    fi
  fi
  TERM_COLS="${TERM_COLS:-80}"
  TERM_LINES="${TERM_LINES:-24}"
}

detect_compact() {
  if [ -n "$COMPACT" ]; then
    return
  fi
  if [ -n "${CLAUDE_SESSIONS_VIEWER_COMPACT:-}" ]; then
    COMPACT="$CLAUDE_SESSIONS_VIEWER_COMPACT"
    return
  fi
  terminal_size
  if [ "$TERM_COLS" -lt "$COMPACT_COLS_THRESHOLD" ] || [ "$TERM_LINES" -lt "$COMPACT_LINES_THRESHOLD" ]; then
    COMPACT=1
  else
    COMPACT=0
  fi
}

# --- Capability detection (graceful behavior on an older claude binary
# that doesn't have --cloud/agents/attach yet) ---------------------------
CLAUDE_HELP_CACHE=""
claude_help_cache() {
  if [ -z "$CLAUDE_HELP_CACHE" ]; then
    CLAUDE_HELP_CACHE=$(claude --help 2>&1) || CLAUDE_HELP_CACHE=""
    [ -z "$CLAUDE_HELP_CACHE" ] && CLAUDE_HELP_CACHE=" "
  fi
}

claude_supports() {
  claude_help_cache
  case "$CLAUDE_HELP_CACHE" in
    *"$1"*) return 0 ;;
    *) return 1 ;;
  esac
}

# Test-only seam: print detection results and exit before touching fzf at
# all (this file has no other non-interactive exit path to test against).
# Not documented in the user-facing README on purpose.
if [ -n "${CLAUDE_SESSIONS_VIEWER_DIAGNOSTIC:-}" ]; then
  detect_compact
  terminal_size
  claude_supports "--cloud" && cloud_ok=1 || cloud_ok=0
  claude_supports "agents" && live_ok=1 || live_ok=0
  claude_supports "attach" && attach_ok=1 || attach_ok=0
  echo "COMPACT=$COMPACT COLS=$TERM_COLS LINES=$TERM_LINES CLOUD_SUPPORTED=$cloud_ok LIVE_SUPPORTED=$live_ok ATTACH_SUPPORTED=$attach_ok"
  exit 0
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required but not installed. Attempting to install it now..." >&2
  if command -v brew >/dev/null 2>&1; then
    brew install fzf >&2
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get install -y fzf >&2
  else
    echo "Could not find a supported package manager (brew or apt-get)." >&2
    echo "Install fzf manually: https://github.com/junegunn/fzf#installation" >&2
    exit 1
  fi
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf installation did not complete successfully. Please install it manually and try again." >&2
  exit 1
fi

detect_compact

# Claude's brand accent color (#d97757), as a 24-bit ANSI escape. Skipped
# for non-interactive terminals or when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  ACCENT=$'\033[38;2;217;119;87m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  ACCENT=""
  BOLD=""
  RESET=""
fi

# The logo used to be plain text printed before fzf launches — but that's
# just static terminal output, and a tall fzf box growing beneath it could
# scroll it out of view (or off-screen entirely on a short terminal), with
# no way to get it back short of restarting. Building it as fzf's own
# --header instead makes it part of fzf's live-managed box: fzf redraws
# its header on every frame, so it can never scroll away or be lost for
# as long as the picker is open. In compact mode, the boxed ASCII logo
# costs 7 lines on a screen that may only have ~20 — it's dropped there
# in favor of one plain line, built below.
LOGO="╭──────────────────────────────────────────╮
│                                          │
│   ┌─┐┌─┐┌─┐┬  ┬                          │
│   │  │  └─┐└┐┌┘                          │
│   └─┘└─┘└─┘ └┘   Claude Code             │
│                       Sessions Viewer    │
│                                          │
╰──────────────────────────────────────────╯
"
if [ "$COMPACT" = "1" ]; then
  HEADER_TEXT="${ACCENT}${BOLD}Claude Sessions${RESET}"
else
  HEADER_TEXT="${ACCENT}${LOGO}${RESET}"
fi

# Shared look: a large, mostly-full-terminal box, with Search as its own
# separate bordered box above the results list. (This split is purely
# visual — in fzf, typing always filters the list immediately from
# anywhere, with no "focus" to navigate into.) Deliberately no --multi, no
# --bind execute()/reload() anywhere in this file: every custom bind using
# those actions was reported to silently do nothing in at least one real
# terminal, while plain accept (the default for Enter, and what
# double-click is explicitly bound to below) reliably works. So the whole
# flow is built entirely out of chained, fresh fzf calls using only that
# one proven-reliable mechanism, with all the "what happens next" logic
# living in this script instead of in fzf's own bind system.
build_fzf_box() {
  if [ "$COMPACT" = "1" ]; then
    # shellcheck disable=SC2054  # commas below are fzf --color value syntax, not array-element separators
    FZF_BOX=(
      --height=100% --margin=0 --padding=0
      --layout=reverse --info=inline
      --input-border=rounded --input-label=" Search " --input-label-pos=3
      --list-border=rounded --list-label-pos=3
      --prompt="> " --pointer=">" --marker="x"
      --bind="double-click:accept"
      --color="pointer:#d97757,prompt:#d97757,marker:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold,input-border:#d97757,input-label:#d97757:bold,list-border:#d97757,list-label:#d97757:bold,header:#d97757,footer:#d97757,border:#d97757,info:#d97757,separator:#d97757,scrollbar:#d97757,spinner:#d97757"
    )
  else
    # shellcheck disable=SC2054
    FZF_BOX=(
      --height=85% --margin=2%,4% --padding=1
      --layout=reverse --info=inline
      --input-border=rounded --input-label=" 🔍 Search " --input-label-pos=3
      --list-border=rounded --list-label-pos=3
      --prompt="❯ " --ghost="Type to search — no need to press anything first" --pointer="▶" --marker="✓"
      --bind="double-click:accept"
      --footer-border=rounded
      --color="pointer:#d97757,prompt:#d97757,marker:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold,input-border:#d97757,input-label:#d97757:bold,list-border:#d97757,list-label:#d97757:bold,header:#d97757,footer:#d97757,footer-border:#d97757,border:#d97757,info:#d97757,separator:#d97757,scrollbar:#d97757,spinner:#d97757"
    )
  fi
}
build_fzf_box

# --- Live Sessions menu: other claude processes already running on this
# machine (interactive or backgrounded), via `claude agents --json` / the
# documented `claude attach <id>` — no tmux dependency. ------------------
live_sessions_menu() {
  local rows sel sid disp act
  rows=$(python3 "$PLUGIN_SCRIPTS/live_sessions.py" --tsv) || rows=""
  if [ -z "$rows" ]; then
    echo "No other active Claude Code sessions found." >&2
    read -r -p "Press enter to continue..." _
    return
  fi

  sel=$(printf '%s\n' "$rows" | \
    fzf --ansi --delimiter=$'\t' --with-nth=7 \
        --header="$HEADER_TEXT" --header-first \
        --list-label=" Live Sessions " \
        --footer="type to search · enter/double-click: select · esc: back" \
        "${FZF_BOX[@]}") || return 0
  [ -z "$sel" ] && return

  sid=$(printf '%s' "$sel" | cut -f5)
  disp=$(printf '%s' "$sel" | cut -f7)
  [ -z "$sid" ] && return

  act=$(printf 'Attach\nBack\n' | \
    fzf --layout=reverse \
        --list-border=rounded --list-label=" $disp " \
        --footer="type to search · enter/double-click: select · esc: back" \
        --prompt="❯ " --pointer="▶" \
        --bind="double-click:accept" \
        --color="pointer:#d97757,prompt:#d97757,list-border:#d97757,list-label:#d97757:bold,footer:#d97757") || return 0

  if [ "$act" = "Attach" ]; then
    # Attaching to a session that's already interactively attached
    # elsewhere is unverified — if it errors, the other session itself
    # is unaffected (see README Known Limitations).
    exec claude attach "$sid"
  fi
}

NEW_SESSION_ROW=$(printf '\t\t\t__NEW_SESSION__\t\t\t%s+ Start New Session%s' "${BOLD}${ACCENT}" "$RESET")
TOGGLE_SORT_ROW=$(printf '\t\t\t__TOGGLE_SORT__\t\t\t%s↕ Toggle Sort%s' "${BOLD}${ACCENT}" "$RESET")
LIVE_SESSIONS_ROW=$(printf '\t\t\t__LIVE_SESSIONS__\t\t\t%s⚡ Live Sessions%s' "${BOLD}${ACCENT}" "$RESET")
CLOUD_SESSIONS_ROW=$(printf '\t\t\t__CLOUD_SESSIONS__\t\t\t%s☁ Cloud Sessions%s' "${BOLD}${ACCENT}" "$RESET")

PINNED_ROWS="$NEW_SESSION_ROW"$'\n'"$TOGGLE_SORT_ROW"
if claude_supports "agents"; then
  PINNED_ROWS="$PINNED_ROWS"$'\n'"$LIVE_SESSIONS_ROW"
fi
if claude_supports "--cloud"; then
  PINNED_ROWS="$PINNED_ROWS"$'\n'"$CLOUD_SESSIONS_ROW"
fi

SORT_MODE="session"

while true; do
  if [ "$SORT_MODE" = "date" ]; then
    LIST_ROWS=$(python3 "$PLUGIN_SCRIPTS/list_sessions.py" --tsv --sort-by=date)
    SORT_LABEL="most recent first"
  else
    LIST_ROWS=$(python3 "$PLUGIN_SCRIPTS/list_sessions.py" --tsv --sort-by=session --grouped)
    SORT_LABEL="A-Z"
  fi

  # --- Step 1: pick a project, alphabetically (or by date), up front. -----
  SELECTED=$(printf '%s\n%s\n' "$PINNED_ROWS" "$LIST_ROWS" | \
    fzf --ansi \
        --delimiter='\t' \
        --with-nth=7 \
        --header="$HEADER_TEXT" \
        --header-first \
        --footer="type to search · enter/double-click: see options · esc: cancel  (sort: $SORT_LABEL)" \
        --list-label=" All Sessions " \
        "${FZF_BOX[@]}")

  if [ -z "$SELECTED" ]; then
    echo "No session selected."
    exit 0
  fi

  SESSION_ID=$(printf '%s' "$SELECTED" | cut -f4)
  DISPLAY_NAME=$(printf '%s' "$SELECTED" | cut -f7)

  # Letter-divider rows are unselectable in spirit — if one somehow gets
  # accepted, just show the list again rather than treating it as a pick.
  case "$DISPLAY_NAME" in
    *§*) continue ;;
  esac

  if [ "$SESSION_ID" = "__TOGGLE_SORT__" ]; then
    if [ "$SORT_MODE" = "date" ]; then SORT_MODE="session"; else SORT_MODE="date"; fi
    continue
  fi

  if [ "$SESSION_ID" = "__LIVE_SESSIONS__" ]; then
    live_sessions_menu
    continue
  fi

  if [ "$SESSION_ID" = "__CLOUD_SESSIONS__" ]; then
    cloud_sessions_menu
    continue
  fi

  if [ "$SESSION_ID" = "__NEW_SESSION__" ]; then
    printf '%sSession name: %s' "${ACCENT}" "${RESET}"
    read -r NEW_NAME
    if [ -n "$NEW_NAME" ]; then
      exec claude "/rename $NEW_NAME"
    else
      exec claude
    fi
  fi

  CD_PATH=$(printf '%s' "$SELECTED" | cut -f3)
  JSONL_PATH=$(printf '%s' "$SELECTED" | cut -f6)
  WHEN=$(printf '%s' "$SELECTED" | cut -f1)

  # --- Step 2: four boxes — Search, the short Open/Rename/Delete/Back
  # list, a small metadata header, and a tall conversation-preview pane
  # (the list is only 4 rows, so the preview can take most of the
  # screen). Every option here is a plain row, picked the exact same
  # (proven-reliable) way as step 1. In compact mode the live preview is
  # dropped (it re-runs preview_session.py on every highlighted row,
  # which is the main memory/CPU cost on a small device); the one-time
  # metadata header is cheap and stays. -----------------------------------
  INFO=$(python3 "$PLUGIN_SCRIPTS/preview_session.py" "$JSONL_PATH" "$WHEN" "$CD_PATH") || INFO=""

  if [ "$COMPACT" = "1" ]; then
    ACTION=$(printf 'Open\nRename\nDelete\nBack\n' | \
      fzf --layout=reverse \
          --input-border=rounded --input-label=" Search " \
          --header="$INFO" --header-border=rounded --header-label=" Info " \
          --list-border=rounded --list-label=" $DISPLAY_NAME " \
          --footer="enter/double-click: select · esc: back" \
          --prompt="> " --pointer=">" \
          --bind="double-click:accept" \
          --color="pointer:#d97757,prompt:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold,input-border:#d97757,input-label:#d97757:bold,list-border:#d97757,list-label:#d97757:bold,header:#d97757,header-border:#d97757,header-label:#d97757:bold,border:#d97757,footer:#d97757") || ACTION=""
  else
    PREVIEW_CMD="python3 $(printf '%q' "$PLUGIN_SCRIPTS/preview_session.py") $(printf '%q' "$JSONL_PATH") --conversation"
    ACTION=$(printf 'Open\nRename\nDelete\nBack\n' | \
      fzf --layout=reverse \
          --input-border=rounded --input-label=" 🔍 Search " \
          --header="$INFO" --header-border=rounded --header-label=" Session Info " \
          --list-border=rounded --list-label=" $DISPLAY_NAME " \
          --preview="$PREVIEW_CMD" \
          --preview-window="down,70%,border-rounded" \
          --preview-label=" Conversation " \
          --footer="type to search · enter/double-click: select · esc: back" \
          --prompt="❯ " --ghost="Type to search" --pointer="▶" \
          --bind="double-click:accept" \
          --color="pointer:#d97757,prompt:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold,input-border:#d97757,input-label:#d97757:bold,list-border:#d97757,list-label:#d97757:bold,header:#d97757,header-border:#d97757,header-label:#d97757:bold,border:#d97757,footer:#d97757") || ACTION=""
  fi

  case "$ACTION" in
    Open)
      if [ ! -f "$JSONL_PATH" ]; then
        echo "This session no longer exists (it may have been deleted)." >&2
        continue
      fi
      if [ ! -d "$CD_PATH" ]; then
        echo "Project directory no longer exists: $CD_PATH" >&2
        read -r -p "Press enter to continue..." _
        continue
      fi
      cd "$CD_PATH"
      exec claude --resume "$SESSION_ID"
      ;;
    Rename)
      printf 'New name: '
      read -r NEW_NAME
      if [ -n "$NEW_NAME" ]; then
        claude --resume "$SESSION_ID" "/rename $NEW_NAME" || true
      fi
      ;;
    Delete)
      CONFIRM=$(printf 'Cancel\nYes, delete\n' | \
        fzf --layout=reverse \
            --list-border=rounded --list-label=" Delete: $DISPLAY_NAME " \
            --footer="type to search · enter/double-click: select · esc: cancel" \
            --footer-border=rounded \
            --prompt="❯ " --pointer="▶" \
            --bind="double-click:accept" \
            --color="pointer:#d97757,prompt:#d97757,list-border:#d97757,list-label:#d97757:bold,footer:#d97757,footer-border:#d97757") || CONFIRM=""
      if [ "$CONFIRM" = "Yes, delete" ]; then
        rm -f -- "$JSONL_PATH"
      fi
      ;;
    *)
      # Back, Esc, or any other cancel — do nothing, loop back to the list.
      ;;
  esac
done
