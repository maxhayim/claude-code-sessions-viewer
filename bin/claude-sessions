#!/usr/bin/env bash
# claude-sessions — visual, fuzzy-searchable browser for every Claude Code
# session on this machine, with a live preview pane. Selecting one resumes it.
#
# Requires fzf: brew install fzf
#
# Run this directly in your terminal (NOT as a /slash-command inside Claude
# Code) — resuming a session has to replace the running process, which a
# plugin command can't do from inside an active session.

set -euo pipefail

# Resolve symlinks (e.g. `ln -s .../bin/claude-sessions /usr/local/bin/...`,
# or a Homebrew-installed symlink) so PLUGIN_SCRIPTS below points at the
# real script directory rather than wherever the symlink lives.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PLUGIN_SCRIPTS="$SCRIPT_DIR/../plugins/sessions-viewer/scripts"

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf is required but not installed. Attempting to install it now..." >&2
  if command -v brew >/dev/null 2>&1; then
    brew install fzf >&2
  elif command -v apt-get >/dev/null 2>&1; then
    sudo apt-get update && sudo apt-get install -y fzf >&2
  else
    echo "Could not find a supported package manager (brew or apt-get)." >&2
    echo "Install fzf manually: https://github.com/junegunn/fzf#installation" >&2
    exit 1
  fi
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "fzf installation did not complete successfully. Please install it manually and try again." >&2
  exit 1
fi

# Claude's brand accent color (#d97757), as a 24-bit ANSI escape. Skipped
# for non-interactive terminals or when NO_COLOR is set.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  ACCENT=$'\033[38;2;217;119;87m'
  BOLD=$'\033[1m'
  RESET=$'\033[0m'
else
  ACCENT=""
  BOLD=""
  RESET=""
fi

cat <<EOF
${ACCENT}   ╭──────────────────────────────────────╮
   │                                        │
   │   ┌─┐┌─┐┌─┐┬  ┬                        │
   │   │  ├─┘└─┐└┐┌┘                        │
   │   └─┘┴  └─┘ └┘   sessions viewer       │
   │                                        │
   │   for Claude Code                      │
   │                                        │
   ╰──────────────────────────────────────╯${RESET}

   ${BOLD}${ACCENT}Claude Code Sessions${RESET}

EOF

# Shared look: a large, mostly-full-terminal box (not a small centered
# tile) so long project/session names don't get clipped, with the search
# input rendered as its own separate bordered box — like a search engine's
# search bar — sitting above the results list, which is also its own
# separate bordered box.
FZF_BOX=(
  --height=92% --margin=2%,4% --padding=1
  --layout=reverse --info=inline
  --input-border=rounded --input-label=" 🔍 Search " --input-label-pos=3
  --list-border=rounded --list-label-pos=3
  --prompt="❯ " --pointer="▶" --marker="✓"
  --bind="double-click:accept"
  --color="pointer:#d97757,prompt:#d97757,marker:#d97757,hl:#d97757,hl+:#d97757,fg+:#ffffff:bold,input-border:#d97757,input-label:#d97757:bold,list-border:#d97757,list-label:#d97757:bold,header:#d97757"
)

# --- All sessions, every project, one list: every session shown by its
# name (or first-message preview if never renamed), alphabetically, grouped
# into dictionary-style letter sections (A, B, C, ...). Moving the selection
# updates the preview pane with when it was last active, where it lives, and
# the conversation itself. Enter/double-click opens it. ---------------------
SELECTED=$(python3 "$PLUGIN_SCRIPTS/list_sessions.py" --tsv --sort-by=session --grouped | \
  fzf --ansi \
      --delimiter='\t' \
      --with-nth=7 \
      --preview="python3 '$PLUGIN_SCRIPTS/preview_session.py' '{6}' '{1}' '{3}'" \
      --preview-window=right:55%:wrap,border-rounded \
      --header="enter/double-click: open  ·  esc: cancel" \
      --list-label=" All Sessions " \
      "${FZF_BOX[@]}")

if [ -z "$SELECTED" ]; then
  echo "No session selected."
  exit 0
fi

# Letter-divider rows are unselectable in spirit — if one somehow gets
# accepted (e.g. a stray Enter), treat it the same as no selection.
case "$(printf '%s' "$SELECTED" | cut -f7)" in
  *§*) echo "No session selected."; exit 0 ;;
esac

SESSION_ID=$(printf '%s' "$SELECTED" | cut -f4)
SESSION_PROJECT_PATH=$(printf '%s' "$SELECTED" | cut -f3)

if [ ! -d "$SESSION_PROJECT_PATH" ]; then
  echo "Project directory no longer exists: $SESSION_PROJECT_PATH" >&2
  exit 1
fi

cd "$SESSION_PROJECT_PATH"
exec claude --resume "$SESSION_ID"
